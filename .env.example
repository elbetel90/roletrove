# Local-development placeholders only. Replace every secret before any
# non-local deploy. Values here are not production credentials.

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://roletrove:devpassword@localhost:5432/roletrove"
POSTGRES_PASSWORD="devpassword"

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─── Typesense ───────────────────────────────────────────────────────────────
TYPESENSE_API_KEY="devtskey"
TYPESENSE_HOST="localhost"
TYPESENSE_PORT="8108"
TYPESENSE_PROTOCOL="http"

# ─── Sequin CDC ──────────────────────────────────────────────────────────────
# Must be at least 64 characters. Used by docker-compose as Sequin SECRET_KEY_BASE.
SEQUIN_SECRET_KEY="devsequinsecretkey64charslongdevsequinsecretkey64chars12345678"

# ─── Better Auth ─────────────────────────────────────────────────────────────
# Must be at least 32 characters
BETTER_AUTH_SECRET="dev-better-auth-secret-32chars!!"
BETTER_AUTH_URL="http://localhost:3000"

# ─── OAuth Providers (optional) ──────────────────────────────────────────────
# GitHub and Google are wired in Better Auth. Leave empty to disable.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── Resend (Email, optional) ────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Jobs <noreply@yourdomain.com>"

# ─── Cloudflare R2 (raw HTML blob storage, optional) ─────────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="roletrove-raw"
R2_PUBLIC_URL=""

# ─── Grafana Cloud (worker observability, optional) ──────────────────────────
GRAFANA_PROMETHEUS_URL=""
GRAFANA_LOKI_URL=""
GRAFANA_API_KEY=""

# ─── Worker ──────────────────────────────────────────────────────────────────
METRICS_PORT="9090"
LOG_LEVEL="info"

# ─── OpenAI (optional — AI matching, not required to run) ────────────────────
OPENAI_API_KEY=""
